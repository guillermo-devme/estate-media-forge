# ─────────────────────────────────────────────────────────────────────────────
# Service auth (Wix Velo backend → this FastAPI service)
# ─────────────────────────────────────────────────────────────────────────────
# Shared static key sent by Wix on every server-to-server call.
FASTAPI_SERVICE_KEY=changeme-static-service-key
# Shared HMAC secret used in BOTH directions (Wix→API request signing, API→Wix refund signing).
SERVICE_HMAC_SECRET=changeme-hmac-secret
# Wix http-function that receives proportional refunds (POST {member_id, job_id, refund_credits}).
WIX_REFUND_URL=https://your-wix-site/_functions/falRefund

# ─────────────────────────────────────────────────────────────────────────────
# fal.ai
# ─────────────────────────────────────────────────────────────────────────────
FAL_KEY=changeme-fal-key

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Append-only usage/audit ledger (NOT a balance authority — balance lives in Wix CMS).
LEDGER_DSN=sqlite+aiosqlite:///./usage.db
# Where generated media is written + served from (StaticFiles).
MEDIA_DIR=./media
# Public base URL used to build absolute media URLs returned to Wix.
PUBLIC_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Concurrency / backpressure
# ─────────────────────────────────────────────────────────────────────────────
MAX_FAL_CONCURRENCY=8
MAX_QUEUE_DEPTH=500

# ─────────────────────────────────────────────────────────────────────────────
# Token economy (USD stays server-side; users only ever see credits)
# credits = provider_cost_usd * EARNINGS_RATIO / CREDIT_PEG_USD
# ─────────────────────────────────────────────────────────────────────────────
EARNINGS_RATIO=3.2
CREDIT_PEG_USD=0.01

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=realestate-media-api
LANGCHAIN_TRACING_V2=false
LOG_LEVEL=INFO
