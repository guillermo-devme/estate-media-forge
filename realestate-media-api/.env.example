# ═══════════════════════════════════════════════════════════════════════════════
# Real-Estate Media-Kit API — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy to `.env` and fill values. NEVER commit `.env` to git.
#
# ENVIRONMENT TIERS:
#   local    → development on your machine (defaults work here)
#   sandbox  → staging/test deployment (shared team secrets, test Wix site)
#   prod     → production (real money, real Wix site, locked ingress)
#
# Values marked [PER-ENV] MUST change between tiers (they reference different
# Wix sites, Stripe accounts, or infrastructure). Manage them via GitHub Actions
# secrets / environment variables in your CI/CD pipeline:
#   Settings → Environments → (local | sandbox | prod) → Environment secrets
#
# Values marked [SHARED] are typically the same across all tiers (tuning knobs,
# economic constants). Override in prod only if you need different behavior.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE AUTH — Wix ↔ FastAPI trust [PER-ENV]
# ─────────────────────────────────────────────────────────────────────────────
# These MUST match the values stored in Wix Secrets Manager on the corresponding
# Wix site (local dev site / sandbox site / prod site). Rotate periodically.
# In GitHub Actions: store as repository or environment secrets.

# Static service key — proves "only Wix can call us".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FASTAPI_SERVICE_KEY=

# HMAC shared secret — signs request bodies in BOTH directions (Wix→API + API→Wix refund).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_HMAC_SECRET=

# Wix http-function URL that receives proportional refunds from the worker.
# Changes per Wix site instance (each tier has its own site).
#   local:   https://your-dev-site.wixsite.com/_functions/falRefund (or a Beeceptor mock)
#   sandbox: https://your-sandbox-site.wixsite.com/_functions/falRefund
#   prod:    https://your-prod-site.wixsite.com/_functions/falRefund
WIX_REFUND_URL=

# ─────────────────────────────────────────────────────────────────────────────
# FAL.AI [PER-ENV in prod; shared key OK for local/sandbox]
# ─────────────────────────────────────────────────────────────────────────────
# Your fal.ai API key. Consider separate keys per environment for billing isolation.
# In GitHub Actions: FAL_KEY secret per environment.
FAL_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE [PER-ENV]
# ─────────────────────────────────────────────────────────────────────────────
# Redis: local uses localhost; sandbox/prod use a managed instance (with persistence!).
#   local:   redis://localhost:6379
#   sandbox: redis://:password@redis-sandbox.internal:6379/0
#   prod:    redis://:password@redis-prod.internal:6379/0
REDIS_URL=redis://localhost:6379

# Usage/audit ledger DSN. Local uses SQLite; prod should point to Postgres + backups.
#   local:   sqlite+aiosqlite:///./usage.db
#   sandbox: postgresql+asyncpg://user:pass@db-sandbox:5432/ledger
#   prod:    postgresql+asyncpg://user:pass@db-prod:5432/ledger
LEDGER_DSN=sqlite+aiosqlite:///./usage.db

# Directory for generated media assets (served via StaticFiles).
# In prod: replace with object storage (S3/GCS signed URLs) and a cleanup policy.
#   local:   ./media
#   prod:    /mnt/media or an object-storage adapter
MEDIA_DIR=./media

# Base URL used to build absolute media asset URLs returned to Wix.
# MUST be the public-facing URL of THIS service as reachable by the Wix frontend.
#   local:   http://localhost:8000
#   sandbox: https://api-sandbox.yourdomain.com
#   prod:    https://api.yourdomain.com
PUBLIC_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# CONCURRENCY & BACKPRESSURE [SHARED — tune per tier if needed]
# ─────────────────────────────────────────────────────────────────────────────
# Max simultaneous fal.ai calls (the semaphore). Higher = more fal spend/throughput.
MAX_FAL_CONCURRENCY=8

# ARQ queue depth at which new submits are shed with 429 + Retry-After.
# Size for your Redis memory; prod may raise this with larger Redis.
MAX_QUEUE_DEPTH=500

# ─────────────────────────────────────────────────────────────────────────────
# TOKEN ECONOMY [SHARED — same across all tiers unless you run a separate pricing test]
# ─────────────────────────────────────────────────────────────────────────────
# credits = provider_cost_usd × EARNINGS_RATIO ÷ CREDIT_PEG_USD
# Changing these changes what members are charged. Coordinate with the Wix site.
EARNINGS_RATIO=3.2
CREDIT_PEG_USD=0.01

# Optional JSON override for the provider cost table (per-stage USD costs).
# Use this to correct fal pricing without a deploy:
#   PRICING_JSON={"upscale": 0.06, "outpaint": 0.045, "i2v": 0.68}
# PRICING_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# FAL MODEL REGISTRY [SHARED — override only if swapping models per tier]
# ─────────────────────────────────────────────────────────────────────────────
# Each can be overridden without code changes. Verify endpoint IDs on fal.ai.
# FAL_MODEL_UPSCALE=fal-ai/clarity-upscaler
# FAL_MODEL_OUTPAINT=fal-ai/flux-2-pro/outpaint
# FAL_MODEL_I2V=bytedance/seedance-2.0/image-to-video

# ─────────────────────────────────────────────────────────────────────────────
# ALERTS & CIRCUIT BREAKER [PER-ENV]
# ─────────────────────────────────────────────────────────────────────────────
# Google Chat webhook URL for operational alerts (fal balance low, circuit tripped).
# Create one at: https://chat.google.com → Space → Apps & integrations → Webhooks.
GOOGLE_CHAT_WEBHOOK_URL=

# Alert when fal.ai account balance drops below this USD amount.
# At $0.68/s for i2v, $20 covers ~30s of video or ~6 full media kits.
FAL_BALANCE_ALERT_THRESHOLD_USD=20.0

# How often the worker checks fal balance (seconds). Default: 5 minutes.
FAL_BALANCE_CHECK_INTERVAL_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY [PER-ENV — different LangSmith projects per tier]
# ─────────────────────────────────────────────────────────────────────────────
# LangSmith tracing (optional but recommended in prod for cost/latency visibility).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=realestate-media-local
# Set per tier: realestate-media-local / realestate-media-sandbox / realestate-media-prod
LANGCHAIN_TRACING_V2=false

# Logging level. Use DEBUG locally, INFO in sandbox/prod.
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# GITHUB ACTIONS INTEGRATION NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Store secrets per environment in GitHub:
#    Settings → Environments → (sandbox | prod) → Add secret
#    Required secrets: FASTAPI_SERVICE_KEY, SERVICE_HMAC_SECRET, WIX_REFUND_URL,
#    FAL_KEY, REDIS_URL, LEDGER_DSN, PUBLIC_BASE_URL, LANGSMITH_API_KEY
#
# 2. In your workflow, reference them:
#    env:
#      FASTAPI_SERVICE_KEY: ${{ secrets.FASTAPI_SERVICE_KEY }}
#      SERVICE_HMAC_SECRET: ${{ secrets.SERVICE_HMAC_SECRET }}
#      ...
#
# 3. SHARED values (EARNINGS_RATIO, CREDIT_PEG_USD, MAX_FAL_CONCURRENCY, etc.)
#    can live as non-secret environment variables in the workflow or as defaults
#    in the deploy config (they contain no sensitive data).
#
# 4. NEVER store .env files in the repo. This .env.example is the reference.
#    If a secret is ever committed by accident, ROTATE IT IMMEDIATELY — consider
#    it compromised (see .kiro/steering/security.md).
#
# 5. For local development: copy this file to .env and fill in your dev values.
#    The defaults (localhost, SQLite, etc.) work for a local-only dev loop.
#
# ═══════════════════════════════════════════════════════════════════════════════
