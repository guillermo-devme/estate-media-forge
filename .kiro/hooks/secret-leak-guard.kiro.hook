{
  "enabled": true,
  "name": "Secret leak guard",
  "description": "Scan saved files for hardcoded secrets, keys, tokens, or committed .env values.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py",
      "**/*.js",
      "**/*.ts",
      "**/*.json",
      "**/*.env*",
      "**/*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Scan the changed file(s) for leaked secrets: API keys, PATs, Stripe keys (sk_/whsec_), HMAC/JWT secrets, FAL_KEY, passwords, private keys, or real values placed where only env/Secrets-Manager references belong. Per .kiro/steering/security.md, secrets must never be hardcoded or committed. If found: tell me exactly where, instruct me to rotate the secret (assume it is compromised once written), replace it with an env/getSecret reference, and ensure the file (e.g. .env, mcp.json) is gitignored. If none, reply 'no secrets detected'."
  }
}
